{
  "name": "mic-clean",
  "productName": "Mic Clean",
  "version": "1.0.0",
  "description": "Any mic, studio clean: double RNNoise, EQ, compressor and limiter as a virtual mic, on Linux, macOS and Windows.",
  "homepage": "https://mohamedjs.github.io/mic-clean/",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohamedjs/mic-clean.git"
  },
  "author": {
    "name": "Mohamed Mahmoud"
  },
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "test": "node --test test/run.js",
    "dist:linux": "bash packaging/linux/fetch-rnnoise.sh && electron-builder --linux deb AppImage --publish never",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "desktopName": "mic-clean.desktop"
}
