      "code": "async function resolveInput() {\n  if (settings.master && !isOurs(settings.master)) return settings.master;\n  const def = await systemDefault();\n  if (!isOurs(def)) return def;          // the mic the system already uses\n  return settings.previousDefault || firstHardwareMic();\n}\n\nasync function restore() {               // when Mic Clean stops\n  if (!isOurs(await systemDefault())) return;\n  await run('pactl', ['set-default-source', previousDefault]);\n}",
